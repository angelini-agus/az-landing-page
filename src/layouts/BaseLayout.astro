---
// Base layout: shared document shell for every page.
// The site language is Spanish (lang="es").
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';


interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
}

const { title, description, canonicalPath = '/', noindex = false } = Astro.props;

const siteUrl = 'https://www.azserviciosdelimpieza.com';
const canonical = new URL(canonicalPath, siteUrl).toString();
const ogImage = new URL('/og-image.jpg', siteUrl).toString();
---

<!doctype html>
<html lang="es" class="overflow-x-clip">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="AZ Servicios de Limpieza" />
    <link rel="canonical" href={canonical} />

    <!-- Robots & Indexing -->
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <!-- Local SEO Geo tags -->
    <meta name="geo.region" content="AR-S" />
    <meta name="geo.placename" content="Rosario" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="AZ Servicios de Limpieza" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Personal de AZ Servicios de Limpieza trabajando con uniforme en un edificio" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#5B4E8A" />



    <!-- Structured data: LocalBusiness -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      '@id': `${siteUrl}/#business`,
      name: 'AZ Servicios de Limpieza',
      description: 'Servicio integral de limpieza profesional para consorcios, oficinas y clínicas en Rosario. Equipo propio con asistencia controlada por QR y GPS.',
      url: siteUrl,
      image: ogImage,
      logo: `${siteUrl}/logo.png`,
      priceRange: '$$',
      areaServed: {
        '@type': 'City',
        name: 'Rosario, Santa Fe, Argentina',
      },
      serviceType: [
        'Limpieza de consorcios',
        'Limpieza de oficinas',
        'Limpieza de clínicas',
      ],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Rosario',
        addressRegion: 'Santa Fe',
        addressCountry: 'AR',
      },
      sameAs: [],
    })} />

    <!-- Structured data: FAQPage -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: '¿Atienden hogares particulares?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. Trabajamos exclusivamente con consorcios, oficinas y clínicas.',
          },
        },
        {
          '@type': 'Question',
          name: '¿Cómo sé si el personal cumplió el turno?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Cada turno se registra con QR y GPS. Podés pedir el reporte de asistencia cuando quieras.',
          },
        },
        {
          '@type': 'Question',
          name: '¿Puedo llamarlos por teléfono?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'El contacto inicial es por mail. Una vez que evaluamos tu caso, seguimos la conversación por WhatsApp para coordinar todo más rápido.',
          },
        },
        {
          '@type': 'Question',
          name: '¿El personal es de ustedes o tercerizado?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Es equipo propio de AZ.',
          },
        },
        {
          '@type': 'Question',
          name: '¿Trabajan con protocolos específicos para clínicas?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Sí, ajustamos frecuencia y protocolo de limpieza según el tipo de espacio y sus requisitos de higiene.',
          },
        },
        {
          '@type': 'Question',
          name: '¿Qué pasa si no estoy conforme con el servicio?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Hacemos seguimiento activo después de empezar — ajustamos frecuencia y protocolo según cómo va funcionando.',
          },
        },
      ],
    })} />
  </head>
  <body class="bg-bg-claro overflow-x-clip max-w-full">
    <Navbar />
    <slot />

    <script>
      import Lenis from 'lenis';

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({
          duration: 1.4,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: true,
          wheelMultiplier: 0.85,
          touchMultiplier: 1.5,
        });

        window.__lenis = lenis;

        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }

        requestAnimationFrame(raf);
      }
    </script>
  </body>
</html>