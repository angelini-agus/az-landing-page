---
// Base layout: shared document shell for every page.
// The site language is Spanish (lang="es").
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import parkinsansLatinUrl from '@fontsource-variable/parkinsans/files/parkinsans-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath = '/' } = Astro.props;

const siteUrl = 'https://azserviciosdelimpieza.com';
const canonical = new URL(canonicalPath, siteUrl).toString();
const ogImage = new URL('/og-image.jpg', siteUrl).toString();
---

<!doctype html>
<html lang="es" class="overflow-x-clip">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="AZ Servicios de Limpieza" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Personal de AZ Servicios de Limpieza trabajando con uniforme en un edificio" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#5B4E8A" />

    <!-- Preload critical display font (hero H1, LCP text) -->
    <link
      rel="preload"
      href={parkinsansLatinUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Structured data: LocalBusiness -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      '@id': `${siteUrl}/#business`,
      name: 'AZ Servicios de Limpieza',
      description: 'Servicio integral de limpieza profesional para consorcios, oficinas y clínicas en Rosario. Equipo propio con asistencia controlada por QR y GPS.',
      url: siteUrl,
      image: ogImage,
      logo: `${siteUrl}/logo.png`,
      priceRange: '$$',
      areaServed: {
        '@type': 'City',
        name: 'Rosario, Santa Fe, Argentina',
      },
      serviceType: [
        'Limpieza de consorcios',
        'Limpieza de oficinas',
        'Limpieza de clínicas',
      ],
      // TODO: completar con datos reales del cliente antes de producción.
      // No se incluye telephone/openingHours: AZ no tiene teléfono público
      // (contacto inicial por mail, WhatsApp solo post-calificación).
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Rosario',
        addressRegion: 'Santa Fe',
        addressCountry: 'AR',
      },
      email: 'TODO@confirmar-mail-real.com',
      sameAs: [],
    })} />
  </head>
  <body class="bg-bg-claro overflow-x-clip max-w-full">
    <Navbar />
    <slot />

    <script>
      import Lenis from 'lenis';

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({
          duration: 1.4,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: true,
          wheelMultiplier: 0.85,
          touchMultiplier: 1.5,
        });

        (window as any).lenis = lenis;

        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }

        requestAnimationFrame(raf);
      }
    </script>
  </body>
</html>