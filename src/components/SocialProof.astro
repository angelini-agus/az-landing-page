      <!-- Right column: compact card with Freshify proportions and ramp top pill -->
      <div class="w-full max-w-[480px] shrink-0">
        <div
          data-reveal
          class="relative flex aspect-[4/4.3] min-h-[380px] sm:min-h-[440px] lg:min-h-[480px] w-full flex-col justify-end overflow-hidden rounded-[32px] sm:rounded-[36px] border border-lila-suave/40 bg-lila-pastel/60 p-5 sm:p-6 shadow-xl"
