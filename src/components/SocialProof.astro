                  <line x1="5" y1="9" x2="43" y2="9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  <rect x="12" y="14" width="9" height="4" rx="0.5" stroke="currentColor" stroke-width="1.2" fill="currentColor" fill-opacity="0.14" />
