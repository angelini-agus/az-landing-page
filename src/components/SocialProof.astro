          <!-- Real team photo (crisp 4K asset rendered with high quality and Retina density) -->
          <Image
            src={sobreNosotrosImg}
            alt="Personal de AZ Servicios de Limpieza uniformado"
            widths={[480, 720, 1024]}
            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 480px"
            quality={95}
            class="absolute inset-0 h-full w-full object-cover object-center"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-indigo-texto/70 via-indigo-texto/10 to-transparent"></div>

          <!-- Floating pills overlaid at the bottom of the card -->
          <div class="relative z-10 flex flex-col gap-3">
            <!-- Pill 1: Lock / shield badge with CTA-style ramp top -->
            <div class="relative isolate flex items-center gap-3.5 px-4.5 py-3.5 sm:px-5 sm:py-4">
              <!-- SVG ramp background: flat base, sloped top edge (left taller), smooth rounded corners -->
              <svg
                class="pointer-events-none absolute inset-0 -z-10 h-full w-full overflow-visible drop-shadow-sm"
