              <!-- Track Set 2 (duplicado exacto para bucle continuo) -->
              <div class="flex items-center gap-10 pr-10 shrink-0 text-lila-medio/75" aria-hidden="true">
                <!-- Torre corporativa -->
                <svg viewBox="0 0 46 46" fill="none" class="h-10 w-auto shrink-0 transition-all duration-200 hover:text-violeta-osc hover:scale-105">
                  <line x1="23" y1="2" x2="23" y2="7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
