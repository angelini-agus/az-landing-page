                  <path d="M21 44V40H27V44" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>

                <!-- Centro médico / clínica -->
                <svg viewBox="0 0 50 46" fill="none" class="h-10 w-auto shrink-0 transition-all duration-200 hover:text-violeta-osc hover:scale-105">
                  <rect x="5" y="12" width="40" height="32" rx="2" stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.06" />
                  <rect x="21" y="5" width="8" height="7" rx="1.5" stroke="currentColor" stroke-width="1.2" fill="currentColor" fill-opacity="0.18" />
                  <path d="M25 7V10M23 8.5H27" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                  <line x1="11" y1="18" x2="39" y2="18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  <line x1="11" y1="24" x2="39" y2="24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  <line x1="11" y1="30" x2="39" y2="30" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
