                <!-- Torre moderna de cristal -->
                <svg viewBox="0 0 44 46" fill="none" class="h-10 w-auto shrink-0 transition-all duration-200 hover:text-violeta-osc hover:scale-105">
                  <path d="M8 44V14L36 6V44H8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="currentColor" fill-opacity="0.06" />
