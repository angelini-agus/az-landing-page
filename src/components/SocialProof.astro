                </svg>

                <!-- Edificio corporativo escalonado -->
                <svg viewBox="0 0 46 46" fill="none" class="h-10 w-auto shrink-0 transition-all duration-200 hover:text-violeta-osc hover:scale-105" aria-hidden="true">
                  <path d="M16 4H30V10H39V44H7V10H16V4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="currentColor" fill-opacity="0.06" />
                  <line x1="23" y1="1" x2="23" y2="4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  <rect x="12" y="16" width="5" height="4" rx="0.5" stroke="currentColor" stroke-width="1" fill="currentColor" fill-opacity="0.12" />
                  <rect x="20" y="16" width="5" height="4" rx="0.5" stroke="currentColor" stroke-width="1" fill="currentColor" fill-opacity="0.12" />
                  <rect x="28" y="16" width="5" height="4" rx="0.5" stroke="currentColor" stroke-width="1" fill="currentColor" fill-opacity="0.12" />
                  <rect x="12" y="24" width="5" height="4" rx="0.5" stroke="currentColor" stroke-width="1" fill="currentColor" fill-opacity="0.12" />
                  <rect x="20" y="24" width="5" height="4" rx="0.5" stroke="currentColor" stroke-width="1" fill="currentColor" fill-opacity="0.12" />
                  <rect x="28" y="24" width="5" height="4" rx="0.5" stroke="currentColor" stroke-width="1" fill="currentColor" fill-opacity="0.12" />
                  <rect x="12" y="32" width="5" height="4" rx="0.5" stroke="currentColor" stroke-width="1" fill="currentColor" fill-opacity="0.12" />
