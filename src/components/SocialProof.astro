                  <rect x="27" y="22" width="9" height="4" rx="0.5" stroke="currentColor" stroke-width="1.2" fill="currentColor" fill-opacity="0.14" />
                  <rect x="12" y="30" width="9" height="4" rx="0.5" stroke="currentColor" stroke-width="1.2" fill="currentColor" fill-opacity="0.14" />
