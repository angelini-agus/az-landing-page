---
// Social proof section for AZ Limpieza — "01 // Who We Are" style from the
// Freshify reference (metrics only, no testimonials per AGENTS.md).
// Uses the confirmed copy: QR+GPS control, 95% fewer internal admin errors,
// and the "own team" badge. The pending "buildings served" metric is NOT
// invented — the card shows the confirmed 95% until the client confirms it.
import { Image } from 'astro:assets';
import sobreNosotrosImg from '../assets/sobre-nosotros.jpg';
import Bubble from './ui/Bubble.astro';
---

<section id="quienes-somos" class="relative flex min-h-[80vh] flex-col justify-center overflow-hidden bg-bg-claro py-14 lg:h-[80vh] lg:min-h-[80vh] lg:py-0">
  <div id="como-trabajamos" class="sr-only"></div>
  <div id="nosotros" class="sr-only"></div>
  <!-- Decorative bubbles: white/gray, blurred, never brand-tinted. -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <Bubble size={280} top={-10} left={-8} blur={60} opacity={0.55} tone="light" duration={6} delay={0.4} />
    <Bubble size={180} top={70} left={90} blur={50} opacity={0.5} tone="gray" duration={5.5} delay={1.2} />
    <Bubble size={100} top={30} left={95} blur={35} opacity={0.45} tone="light" duration={5} delay={0.8} />
  </div>

  <div class="container-page relative w-full">
    <div
      class="flex flex-col gap-12 lg:flex-row lg:items-center lg:justify-between lg:gap-16 xl:gap-[240px]"
    >
      <!-- Left column: wider (max-w-[580px]), headline, copy, and carousel placeholder -->
      <div class="w-full max-w-[580px] space-y-6">
        <p
          class="font-display text-sm font-medium uppercase tracking-[0.12em] text-violeta-osc"
        >
          01 // Quiénes somos
        </p>

        <h2
          class="font-display text-4xl font-semibold leading-[1.15] tracking-[-0.01em] text-indigo-texto sm:text-5xl lg:text-[3.25rem]"
        >
          Limpieza con control real, turno por turno
        </h2>

        <div class="space-y-4 text-base leading-relaxed text-texto-secundario">
          <p>
            Pensado para administradores de consorcios, oficinas y clínicas que
            necesitan saber qué pasó, no solo confiar en que pasó.
          </p>
          <p>
            Cada turno queda registrado con QR y GPS: no hace falta que un
            vecino o un empleado te avise si faltó alguien. El equipo es propio
            y los protocolos están documentados.
          </p>
        </div>

        <!-- Generic architectural building marquee in delimited space -->
        <div class="pt-6 border-t border-lila-suave/40">
          <div
            class="relative w-full overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)] [-webkit-mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]"
            aria-hidden="true"
          >
            <div
              class="flex w-max items-center py-1.5 animate-marquee select-none hover:[animation-play-state:paused]"
            >
              <!-- Track Set 1 -->
              <div class="flex items-center gap-10 pr-10 shrink-0 text-lila-medio/75">
                <!-- Torre corporativa -->
                <svg viewBox="0 0 46 46" fill="none" class="h-10 w-auto shrink-0 transition-all duration-200 hover:text-violeta-osc hover:scale-105" aria-hidden="true">
                  <line x1="23" y1="2" x2="23" y2="7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  <rect x="18" y="7" width="10" height="3" rx="0.5" stroke="currentColor" stroke-width="1.5" />
                  <rect x="11" y="10" width="24" height="34" rx="2" stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.06" />
                  <line x1="16" y1="16" x2="19" y2="16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  <line x1="27" y1="16" x2="30" y2="16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  <line x1="16" y1="22" x2="19" y2="22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  <line x1="27" y1="22" x2="30" y2="22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  <line x1="16" y1="28" x2="19" y2="28" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  <line x1="27" y1="28" x2="30" y2="28" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  <line x1="16" y1="34" x2="19" y2="34" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  <line x1="27" y1="34" x2="30" y2="34" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  <path d="M20 44V38H26V44" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>

                <!-- Consorcio residencial -->
