---
// ServicesSection.astro — Interactive B2B services section with sticky stacking cards.
// In desktop, cards stack and overlap at top-[7rem] (matching navbar offset).
import { Image } from 'astro:assets';
import consorciosImg from '../assets/servicio-consorcios.jpg';
import oficinasImg from '../assets/servicio-oficinas.jpg';
import clinicasImg from '../assets/servicio-clinicas.jpg';
import Bubble from './ui/Bubble.astro';

export interface ServiceItem {
  id: string;
  title: string;
  description: string;
  tags: string[];
  image?: ImageMetadata;
  imagePosition?: string;
  imagePlaceholderUrl?: string;
  link?: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  services?: ServiceItem[];
}

const defaultServices: ServiceItem[] = [
  {
    id: 'oficinas',
    title: 'Limpieza de Oficinas y Empresas',
    description:
      'Programamos la limpieza según el ritmo de tu equipo: mantenimiento de puestos de trabajo, salas de reunión, office y sanitarios sin frenar tu jornada.',
    tags: ['Puestos operativos', 'Salas de reunión', 'Sanitarios y office', 'Turnos flexibles'],
    image: oficinasImg,
    link: '#contacto',
  },
  {
    id: 'consorcios',
    title: 'Limpieza de Consorcios y Edificios',
    description:
      'Mantenimiento integral de áreas comunes: halls, escaleras, ascensores y cocheras. Cada turno queda registrado con QR y GPS.',
    tags: ['Halls y accesos', 'Áreas comunes', 'Cocheras y veredas', 'Control QR y GPS'],
    image: consorciosImg,
    imagePosition: 'object-bottom',
    link: '#contacto',
  },
  {
    id: 'clinicas',
    title: 'Clínicas y Centros de Salud',
    description:
      'Protocolos de desinfección e higiene para consultorios, salas de espera y áreas sensibles, con personal propio capacitado y reporte de cada turno.',
    tags: ['Protocolos sanitarios', 'Desinfección profunda', 'Zonas médicas y consultorios', 'Reporte de cumplimiento'],
    image: clinicasImg,
    link: '#contacto',
  },
];

const {
  eyebrow = '02 // Nuestros servicios',
  title = 'Limpieza pensada para tu tipo de espacio',
  services = defaultServices,
} = Astro.props;
---

<section id="servicios" class="relative bg-bg-claro py-16 lg:py-24 overflow-visible">
  <!-- Subtle decorative bubbles -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <Bubble size={240} top={15} left={-6} blur={55} opacity={0.4} tone="light" duration={6} delay={0.2} />
    <Bubble size={160} top={75} left={92} blur={45} opacity={0.45} tone="gray" duration={5.5} delay={1} />
  </div>

  <div class="container-page relative overflow-visible">
    <!-- Header: Eyebrow + Headline with generous spacing -->
    <div data-reveal class="mb-10 max-w-2xl lg:mb-14">
      <p class="font-display text-sm font-medium uppercase tracking-[0.12em] text-violeta-osc">
        {eyebrow}
      </p>
      <h2
        class="font-display mt-3 text-3xl font-semibold leading-[1.15] tracking-[-0.01em] text-indigo-texto sm:text-4xl lg:text-[2.75rem]"
      >
        {title}
      </h2>
    </div>

    <!-- Sticky Stacking Cards Container -->
    <div class="relative flex flex-col gap-6 lg:gap-8 pb-12 lg:pb-24 overflow-visible">
      {
        services.map((service, index) => {
          const itemLink = service.link || '#contacto';
          const zIndex = (index + 1) * 10;

          return (
            <div
              data-reveal
              data-reveal-delay={index * 80}
              class="relative transition-all duration-300 lg:sticky"
              style={`top: 7rem; z-index: ${zIndex};`}
            >
              <article class="group relative overflow-hidden rounded-[28px] border border-lila-suave/45 bg-[#FAF8FE] p-5 shadow-lg transition-all duration-300 hover:border-lila-medio/60 hover:shadow-2xl sm:p-6 lg:h-[calc((100vh-9rem)/2)] lg:min-h-[360px] lg:max-h-[420px] lg:rounded-[36px] lg:p-7">
                <div class="flex h-full flex-col gap-6 sm:flex-row sm:items-center sm:justify-between lg:gap-10">
                  <!-- 1. Left: Image container with strict height containment -->
                  <div class="relative aspect-[16/10] w-full shrink-0 overflow-hidden rounded-2xl border border-lila-suave/35 bg-gradient-to-br from-lila-pastel via-bg-claro to-lila-suave/25 shadow-2xs sm:h-full sm:w-[240px] md:w-[290px] lg:w-[340px] xl:w-[380px] lg:rounded-[24px]">
                    {service.image ? (
                      <Image
                        src={service.image}
                        alt={service.title}
                        widths={[340, 480, 720, 1000, 1400]}
                        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 340px, 380px"
                        quality={92}
                        class={`h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 motion-reduce:transform-none ${service.imagePosition || 'object-center'}`}
                      />
                    ) : service.imagePlaceholderUrl ? (
                      <img
                        src={service.imagePlaceholderUrl}
                        alt={service.title}
                        class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 motion-reduce:transform-none"
                        loading="lazy"
                      />
                    ) : (
                      <div class="flex h-full w-full flex-col items-center justify-center gap-3 p-6 text-center transition-transform duration-500 ease-out group-hover:scale-105 motion-reduce:transform-none">
                        <div class="grid h-12 w-12 place-items-center rounded-2xl bg-white text-violeta-osc shadow-xs">
                          <svg
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.75"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="h-6 w-6"
                            aria-hidden="true"
                          >
                            {service.id === 'consorcios' && (
                              <>
                                <rect width="16" height="20" x="4" y="2" rx="2" />
                                <path d="M9 22v-4h6v4" />
                                <path d="M8 6h.01" />
                                <path d="M16 6h.01" />
                                <path d="M8 10h.01" />
                                <path d="M16 10h.01" />
                                <path d="M8 14h.01" />
                                <path d="M16 14h.01" />
                              </>
                            )}
                            {service.id === 'oficinas' && (
                              <>
                                <rect width="20" height="14" x="2" y="7" rx="2" />
                                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                              </>
                            )}
                            {service.id === 'clinicas' && (
                              <>
                                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
                                <path d="M12 9v4" />
                                <path d="M10 11h4" />
                              </>
                            )}
                            {!['consorcios', 'oficinas', 'clinicas'].includes(service.id) && (
                              <>
                                <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48" />
                              </>
                            )}
                          </svg>
                        </div>
                        <span class="text-xs font-semibold uppercase tracking-wider text-texto-secundario/75">
                          Espacio para imagen
                        </span>
                      </div>
                    )}
                  </div>

                  <!-- 2. Center: Title, Description, Chips -->
                  <div class="flex flex-1 flex-col justify-center space-y-3 py-1 lg:space-y-4">
                    <h3 class="font-display text-2xl font-semibold tracking-[-0.01em] text-indigo-texto transition-colors duration-200 group-hover:text-violeta-osc lg:text-3xl">
                      {service.title}
                    </h3>
                    <p class="max-w-xl text-sm leading-relaxed text-texto-secundario sm:text-base">
                      {service.description}
                    </p>

                    <!-- Chips / Subservice Pills -->
                    <div class="flex flex-wrap gap-2 pt-1">
                      {service.tags.map((tag) => (
                        <span class="inline-flex items-center rounded-full border border-lila-suave/45 bg-lila-pastel/45 px-3.5 py-1 text-xs font-medium text-texto-secundario shadow-2xs transition-colors duration-200 hover:border-violeta-osc hover:bg-violeta-osc hover:text-white">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>

                  <!-- 3. Right: Action Indicator (Minimalist Diagonal Arrow ↗) -->
                  <div class="flex shrink-0 items-center sm:self-center">
                    <a
                      href={itemLink}
                      aria-label={`Consultar por ${service.title}`}
                      class="group/btn grid h-12 w-12 place-items-center rounded-2xl border border-lila-suave/40 bg-white text-texto-secundario shadow-xs transition-all duration-300 hover:border-violeta-osc hover:bg-violeta-osc hover:text-white hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violeta-osc lg:h-14 lg:w-14"
                    >
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-5 w-5 transition-transform duration-300 group-hover/btn:-translate-y-1 group-hover/btn:translate-x-1 motion-reduce:transform-none lg:h-6 lg:w-6"
                        aria-hidden="true"
                      >
                        <path d="M7 17L17 7" />
                        <path d="M7 7h10v10" />
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  const revealTargets = document.querySelectorAll<HTMLElement>('#servicios [data-reveal]');

  if (revealTargets.length) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      revealTargets.forEach((target) => target.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 },
      );
      revealTargets.forEach((target) => observer.observe(target));
    }
  }
</script>
