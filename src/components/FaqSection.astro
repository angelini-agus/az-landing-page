---
// FaqSection.astro — Frequently Asked Questions section (05 // PREGUNTAS FRECUENTES).
// Accordion with smooth grid-template-rows expansion and animated action buttons matching the site's design system.
import Bubble from './ui/Bubble.astro';

export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  faqs?: FaqItem[];
}

const defaultFaqs: FaqItem[] = [
  {
    question: '¿Atienden hogares particulares?',
    answer: 'No. Trabajamos exclusivamente con consorcios, oficinas y clínicas.',
  },
  {
    question: '¿Cómo sé si el personal cumplió el turno?',
    answer: 'Cada turno se registra con QR y GPS, y podés pedir el reporte de asistencia cuando quieras.',
  },
  {
    question: '¿Puedo llamarlos por teléfono?',
    answer:
      'El contacto inicial es por mail. Una vez que evaluamos tu caso, seguimos la conversación por WhatsApp para coordinar todo más rápido.',
  },
  {
    question: '¿El personal es de ustedes o tercerizado?',
    answer: 'Es equipo propio de AZ.',
  },
  {
    question: '¿Trabajan con protocolos específicos para clínicas?',
    answer:
      'Sí. Ajustamos frecuencia y protocolo de limpieza según el tipo de espacio y sus requisitos de higiene.',
  },
  {
    question: '¿Qué pasa si no estoy conforme con el servicio?',
    answer:
      'Hacemos seguimiento activo después de arrancar y ajustamos frecuencia y protocolo según cómo funcione.',
  },
];

const {
  eyebrow = '06 // Preguntas frecuentes',
  title = 'Preguntas frecuentes',
  faqs = defaultFaqs,
} = Astro.props;
---

<section
  id="faq"
  class="relative min-h-screen bg-bg-claro py-16 lg:py-24 flex items-center overflow-visible"
>
  <!-- Decorative bubbles -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <Bubble size={280} top={-10} left={-6} blur={65} opacity={0.4} tone="light" duration={6} delay={0} />
    <Bubble size={200} top={80} left={90} blur={50} opacity={0.35} tone="gray" duration={5.5} delay={1.4} />
  </div>

  <div class="container-page relative w-full">
    <!-- Section header -->
    <div class="mb-12 lg:mb-16 text-center">
      <p
        data-reveal
        class="font-display text-sm font-semibold uppercase tracking-[0.12em] text-violeta-osc"
        style="--reveal-delay: 0ms"
      >
        {eyebrow}
      </p>
      <h2
        data-reveal
        class="font-display mx-auto mt-3 max-w-2xl text-3xl font-semibold leading-[1.15] tracking-[-0.01em] text-indigo-texto sm:text-4xl lg:text-5xl"
        style="--reveal-delay: 80ms"
      >
        {title}
      </h2>
    </div>

    <!-- FAQ Accordion List -->
    <div class="mx-auto max-w-3xl space-y-3.5">
      {
        faqs.map((faq, index) => {
          const answerId = `faq-answer-${index}`;
          const triggerId = `faq-trigger-${index}`;
          const isFirst = index === 0;
          return (
            <div
              data-reveal
              data-faq-item
              data-open={isFirst ? 'true' : undefined}
              class="faq-card group relative overflow-hidden rounded-2xl border border-lila-suave/40 bg-[#FAF8FE] p-5 sm:p-6 shadow-xs transition-all duration-300 hover:border-lila-medio/60 hover:shadow-md data-[open]:border-violeta-osc/70 data-[open]:bg-white data-[open]:shadow-md"
              style={`--reveal-delay: ${150 + index * 70}ms`}
            >
              <button
                type="button"
                id={triggerId}
                aria-expanded={isFirst ? 'true' : 'false'}
                aria-controls={answerId}
                class="faq-trigger flex w-full items-center justify-between gap-4 text-left cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-lila-medio rounded-lg"
              >
                <span class="font-display text-base font-bold leading-snug text-indigo-texto transition-colors duration-200 group-hover:text-violeta-osc group-data-[open]:text-violeta-osc sm:text-lg">
                  {faq.question}
                </span>

                <!-- Action Button with animated arrow (Freshify style) -->
                <span
                  class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl border border-lila-suave/45 bg-white text-texto-secundario shadow-xs transition-all duration-300 group-hover:border-violeta-osc group-hover:bg-violeta-osc group-hover:text-white group-data-[open]:border-violeta-osc group-data-[open]:bg-violeta-osc group-data-[open]:text-white group-data-[open]:shadow-md sm:h-12 sm:w-12"
                  aria-hidden="true"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-5 w-5 transition-transform duration-300 group-data-[open]:rotate-180 motion-reduce:transition-none"
                  >
                    <path d="M12 5v14" />
                    <path d="m19 12-7 7-7-7" />
                  </svg>
                </span>
              </button>

              <!-- Animated Accordion Body using CSS Grid Template Rows -->
              <div
                id={answerId}
                role="region"
                aria-labelledby={triggerId}
                class="faq-content grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out group-data-[open]:grid-rows-[1fr]"
              >
                <div class="overflow-hidden">
                  <p class="pt-4 pr-12 text-sm leading-relaxed text-texto-secundario sm:text-base">
                    {faq.answer}
                  </p>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  // Scoped Accordion Handler
  const faqItems = document.querySelectorAll<HTMLElement>('#faq [data-faq-item]');

  faqItems.forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>('.faq-trigger');

    trigger?.addEventListener('click', () => {
      const isOpen = item.hasAttribute('data-open');

      // Close all other items for a clean single-open accordion feel
      faqItems.forEach((other) => {
        if (other !== item) {
          other.removeAttribute('data-open');
          other.querySelector('.faq-trigger')?.setAttribute('aria-expanded', 'false');
        }
      });

      // Toggle current item
      if (isOpen) {
        item.removeAttribute('data-open');
        trigger.setAttribute('aria-expanded', 'false');
      } else {
        item.setAttribute('data-open', 'true');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Reveal-on-scroll IntersectionObserver
  const revealTargets = document.querySelectorAll<HTMLElement>('#faq [data-reveal]');

  if (revealTargets.length) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      revealTargets.forEach((el) => el.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.1 },
      );
      revealTargets.forEach((el) => observer.observe(el));
    }
  }
</script>
