---
// Hero section for AZ Limpieza — Freshify-inspired layout (~200vh).
// Top row: giant headline | stat pills | copy + CTA. Below: the photo
// band, full-width, occupying the middle of the hero with the real AZ team.
import { Image } from 'astro:assets';
import heroImg from '../assets/hero.jpg';
import bubbleSingleImg from '../assets/bubble-single.png';
import bubbleDoubleImg from '../assets/bubble-double.png';
import Bubble from './ui/Bubble.astro';
import CtaRampButton from './ui/CtaRampButton.astro';

const ctaHref = '#contacto';
---

<section id="inicio" class="relative overflow-hidden bg-bg-claro pt-24 pb-12 sm:pt-28 sm:pb-16 lg:pt-0 lg:pb-0 lg:block">
  <!-- Decorative bubbles: white/gray, blurred, never brand-tinted.
       Kept on desktop; subtle on mobile. -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute inset-0 hidden lg:block">
      <Bubble size={380} top={-16} left={55} blur={70} opacity={0.6} tone="gray" duration={6} delay={0} />
      <Bubble size={200} top={55} left={-6} blur={55} opacity={0.5} tone="light" duration={5.5} delay={0.6} />
      <Bubble size={140} top={10} left={88} blur={45} opacity={0.5} tone="gray" duration={5} delay={1} />
    </div>
  </div>

  <div class="container-page relative">
    <!-- Top row: headline, stat pills, copy + CTA -->
    <div
      class="relative flex flex-col gap-6 pt-4 pb-8 sm:gap-8 sm:pt-6 sm:pb-10 lg:h-[55vh] lg:min-h-[55vh] lg:justify-center lg:p-0 lg:pt-20 lg:pb-0"
    >
      <div
        class="flex flex-col gap-5 sm:gap-6 lg:grid lg:grid-cols-[1.2fr_auto_auto] lg:items-stretch lg:gap-16"
      >
        <!-- Giant headline -->
        <h1 class="font-display text-4xl sm:text-5xl lg:text-[7.5rem] font-semibold leading-[1.04] lg:leading-[0.98] tracking-[-0.01em] text-indigo-texto">
          Espacios
          <br />
          impecables
        </h1>

        <!-- Stat pills (confirmed client metrics) -->
        <div class="flex flex-row flex-wrap items-center gap-2.5 sm:gap-3 lg:flex-col lg:items-start lg:justify-end lg:gap-4 lg:min-w-fit">
          <span class="inline-flex h-11 sm:h-12 lg:h-16 items-center gap-2.5 sm:gap-3 lg:gap-3.5 rounded-xl sm:rounded-2xl bg-lila-pastel/90 px-3.5 sm:px-4 lg:px-5 shadow-xs border border-lila-suave/30">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4 lg:h-5 lg:w-5 text-lila-medio"
              aria-hidden="true"
            >
              <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z" />
              <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" />
              <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2" />
              <path d="M10 6h4" />
              <path d="M10 10h4" />
              <path d="M10 14h4" />
              <path d="M10 18h4" />
            </svg>
            <span class="flex flex-col leading-tight">
              <span class="font-display text-sm sm:text-base lg:text-lg font-bold text-violeta-osc">50+</span>
              <span class="text-[9px] sm:text-[10px] lg:text-[11px] font-semibold uppercase tracking-wider text-violeta-osc">edificios cubiertos</span>
            </span>
          </span>

          <span class="inline-flex h-11 sm:h-12 lg:h-16 items-center gap-2.5 sm:gap-3 lg:gap-3.5 rounded-xl sm:rounded-2xl bg-lila-pastel/90 px-3.5 sm:px-4 lg:px-5 shadow-xs border border-lila-suave/30">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4 lg:h-5 lg:w-5 text-lila-medio"
              aria-hidden="true"
            >
              <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
              <path d="M3 3v5h5" />
              <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" />
              <path d="M16 16h5v5" />
            </svg>
            <span class="flex flex-col leading-tight">
              <span class="font-display text-sm sm:text-base lg:text-lg font-bold text-violeta-osc">98%</span>
              <span class="text-[9px] sm:text-[10px] lg:text-[11px] font-semibold uppercase tracking-wider text-violeta-osc">de renovación de clientes</span>
            </span>
          </span>
        </div>

        <!-- Copy + CTA -->
        <div class="flex w-full max-w-sm flex-col justify-end gap-3 sm:gap-4 lg:gap-6">
          <p class="text-sm sm:text-base leading-relaxed text-texto-secundario font-normal lg:font-medium">
            Equipo propio, turnos controlados por QR y GPS. Presupuesto personalizado en menos de 72 hs.
          </p>
          <CtaRampButton href={ctaHref} class="w-full sm:w-auto">
            Pedí tu presupuesto por mail
          </CtaRampButton>
        </div>
      </div>
    </div>

    <!-- Photo band: full-width, placed below text on mobile and desktop alike -->
    <div class="relative block pb-12 sm:pb-16 lg:pb-24">
      <!-- Soap bubble resting on the top edge of the photo card (Freshify reference) -->
      <div
        class="pointer-events-none absolute left-[37.1%] top-0 z-20 -translate-x-1/2 -translate-y-1/2 select-none"
        aria-hidden="true"
      >
        <Image
          src={bubbleSingleImg}
          alt=""
          class="h-12 w-12 sm:h-16 sm:w-16 lg:h-[92px] lg:w-[92px] xl:h-[102px] xl:w-[102px] object-contain animate-bubble-float"
          loading="lazy"
        />
      </div>

      <div
        class="relative mx-auto h-[36vh] sm:h-[48vh] md:h-[60vh] lg:h-[77.77vh] w-full overflow-hidden rounded-2xl sm:rounded-3xl bg-lila-suave/25 shadow-xl lg:rounded-[36px] lg:shadow-2xl"
      >
        <Image
          src={heroImg}
          alt="Personal de AZ Servicios de Limpieza trabajando con uniforme en el hall de un edificio"
          class="h-full w-full object-cover object-[center_30%]"
          widths={[480, 720, 1080, 1440, 1920]}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 95vw, 1440px"
          quality={80}
          loading="lazy"
          decoding="async"
        />

        <!-- Double bubble in bottom-right corner (Freshify reference) -->
        <div
          class="pointer-events-none absolute bottom-[8%] right-[6%] sm:right-[11%] lg:bottom-[9%] lg:right-[12%] z-10 select-none"
          aria-hidden="true"
        >
          <Image
            src={bubbleDoubleImg}
            alt=""
            class="h-14 w-14 sm:h-20 sm:w-20 lg:h-[106px] lg:w-[106px] xl:h-[118px] xl:w-[118px] object-contain animate-bubble-float-delayed"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes bubble-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @keyframes bubble-float-alt {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(8px) rotate(2deg);
    }
  }

  .animate-bubble-float {
    animation: bubble-float 5s ease-in-out infinite;
  }

  .animate-bubble-float-delayed {
    animation: bubble-float-alt 5s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-bubble-float,
    .animate-bubble-float-delayed {
      animation: none;
    }
  }
</style>