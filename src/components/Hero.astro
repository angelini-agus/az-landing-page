---
// Hero section for AZ Limpieza — Freshify-inspired layout (~200vh).
// Top row: giant headline | stat pills | copy + CTA. Below: the photo
// band, full-width, occupying the middle of the hero with the real AZ team.
import { Image } from 'astro:assets';
import heroImg from '../assets/hero.jpg';
import Bubble from './ui/Bubble.astro';
import CtaRampButton from './ui/CtaRampButton.astro';

const ctaHref = '#contacto';
---

<section id="inicio" class="relative overflow-hidden bg-bg-claro">
  <!-- Decorative bubbles: white/gray, blurred, never brand-tinted.
       Small set, kept away from the text column. -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute inset-0 lg:hidden">
      <Bubble size={160} top={-6} left={-10} blur={45} opacity={0.6} tone="gray" duration={6} delay={0} />
      <Bubble size={100} top={20} left={80} blur={35} opacity={0.5} tone="light" duration={5} delay={0.8} />
      <Bubble size={60} top={70} left={-4} blur={25} opacity={0.5} tone="light" duration={5.5} delay={0.4} />
    </div>
    <div class="absolute inset-0 hidden lg:block">
      <Bubble size={380} top={-16} left={55} blur={70} opacity={0.6} tone="gray" duration={6} delay={0} />
      <Bubble size={200} top={55} left={-6} blur={55} opacity={0.5} tone="light" duration={5.5} delay={0.6} />
      <Bubble size={140} top={10} left={88} blur={45} opacity={0.5} tone="gray" duration={5} delay={1} />
    </div>
  </div>

  <div class="container-page relative">
    <!-- Top row container: occupies the first 55vh on desktop, centered vertically between navbar and photo -->
    <div
      class="flex min-h-[100svh] flex-col justify-center pt-28 pb-10 lg:h-[55vh] lg:min-h-[55vh] lg:justify-center lg:pt-20 lg:pb-0"
    >
      <div
        class="flex flex-col gap-10 lg:grid lg:grid-cols-[1.2fr_auto_auto] lg:items-stretch lg:gap-16"
      >
        <!-- Giant headline -->
        <h1 class="font-display text-5xl font-semibold leading-[0.98] tracking-[-0.01em] text-indigo-texto sm:text-6xl lg:text-[7.5rem]">
          Espacios
          <br />
          impecables
        </h1>

        <!-- Stat pills (confirmed client metrics) -->
        <div class="flex flex-col items-start justify-end gap-4 lg:min-w-fit">
          <span class="inline-flex h-16 items-center gap-3.5 rounded-2xl bg-lila-pastel px-5">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5 text-lila-medio"
              aria-hidden="true"
            >
              <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z" />
              <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" />
              <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2" />
              <path d="M10 6h4" />
              <path d="M10 10h4" />
              <path d="M10 14h4" />
              <path d="M10 18h4" />
            </svg>
            <span class="flex flex-col leading-tight">
              <span class="font-display text-lg font-bold text-violeta-osc">50+</span>
              <span class="text-[11px] font-semibold uppercase tracking-wider text-violeta-osc">edificios cubiertos</span>
            </span>
          </span>

          <span class="inline-flex h-16 items-center gap-3.5 rounded-2xl bg-lila-pastel px-5">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5 text-lila-medio"
              aria-hidden="true"
            >
              <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
              <path d="M3 3v5h5" />
              <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" />
              <path d="M16 16h5v5" />
            </svg>
            <span class="flex flex-col leading-tight">
              <span class="font-display text-lg font-bold text-violeta-osc">98%</span>
              <span class="text-[11px] font-semibold uppercase tracking-wider text-violeta-osc">de renovación de clientes</span>
            </span>
          </span>
        </div>

        <!-- Copy + CTA -->
        <div class="flex w-full max-w-sm flex-col justify-end gap-4 lg:gap-6">
          <p class="text-base leading-relaxed text-texto-secundario">
            Equipo propio, turnos controlados por QR y GPS. Presupuesto personalizado en menos de 72 hs.
          </p>
          <CtaRampButton href={ctaHref} class="w-full sm:w-auto">
            Pedí tu presupuesto por mail
          </CtaRampButton>
        </div>
      </div>
    </div>

    <!-- Photo band: full-width, begins after 55vh, height 77.77vh -->
    <div class="relative pb-16 lg:pb-24">
      <div
        class="relative mx-auto h-[60vh] sm:h-[70vh] lg:h-[77.77vh] w-full overflow-hidden rounded-3xl bg-lila-suave/25 shadow-2xl lg:rounded-[36px]"
      >
        <Image
          src={heroImg}
          alt="Personal de AZ Servicios de Limpieza trabajando con uniforme en el hall de un edificio"
          class="h-full w-full object-cover object-[center_30%]"
          widths={[720, 1080, 1440, 1920, 2560]}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 95vw, 1440px"
          quality={90}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>