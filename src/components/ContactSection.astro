---
// ContactSection.astro — Final CTA & Contact Form section (#contacto).
// Photo banner at top with glassmorphic contact card overlapping it, matching the visual reference.
import Bubble from './ui/Bubble.astro';
import CtaRampButton from './ui/CtaRampButton.astro';
import auroraUrl from '../assets/contact-aurora-bg.svg?url';

interface Props {
  eyebrow?: string;
}

const {
  eyebrow = '07 // Contacto',
} = Astro.props;
---

<section
  id="contacto"
  class="relative min-h-[calc(100vh-5.5rem)] flex flex-col justify-center overflow-visible bg-bg-claro py-8 lg:py-12"
>
  <div class="relative mx-auto w-full px-2 sm:px-4 lg:px-6 pt-6 sm:pt-8 lg:pt-10 pb-8 sm:pb-10 lg:pb-0">
    <!-- Top Photo Banner (SVG aurora gradient background in violet palette) -->
    <div
      data-contact-banner
      class="absolute inset-x-2 sm:inset-x-4 top-6 sm:top-8 bottom-0 overflow-hidden rounded-[2.5rem] bg-[#140F22] shadow-xl lg:static lg:inset-auto lg:h-[528px] lg:w-full"
    >
      <!-- SVG Aurora Background -->
      <img
        src={auroraUrl}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 z-0 h-full w-full object-cover object-top"
        fetchpriority="low"
        loading="lazy"
      />

      <!-- Floating decorative bubbles overlapping the banner edges -->
      <div class="pointer-events-none absolute inset-0 z-10 overflow-hidden" aria-hidden="true">
        <Bubble size={180} top={12} left={-4} blur={40} opacity={0.35} tone="light" duration={6} delay={0} />
        <Bubble size={240} top={20} left={85} blur={50} opacity={0.3} tone="gray" duration={7} delay={1} />
      </div>
    </div>

    <!-- Glassmorphic Overlapping Contact Card -->
    <div class="container-page relative z-10 pt-10 sm:pt-14 lg:pt-0 lg:-mt-[376px]">
      <div
        data-reveal
        class="relative mx-auto max-w-3xl rounded-[2.5rem] border border-white/80 bg-[#FAF8FE]/90 p-6 sm:p-10 lg:p-14 shadow-2xl backdrop-blur-xl transition-all duration-300 hover:border-white"
      >
      <!-- Stepper Progress Header -->
      <div class="mb-6 sm:mb-8" id="form-stepper" aria-label="Progreso del formulario">
        <div class="flex items-center justify-between gap-2 max-w-xs mx-auto">
          <!-- Step 1 Indicator -->
          <div class="flex items-center gap-2 flex-1" id="step-indicator-1">
            <span class="step-badge grid h-7 w-7 shrink-0 place-items-center rounded-full text-xs font-bold transition-all duration-300 bg-violeta-osc text-white shadow-sm">
              1
            </span>
            <span class="step-label text-xs font-semibold tracking-wider text-indigo-texto hidden sm:inline">
              Espacio
            </span>
          </div>
          <div class="h-0.5 flex-1 bg-lila-suave/40 rounded-full overflow-hidden">
            <div class="step-line-fill h-full w-0 bg-violeta-osc transition-all duration-300" id="step-line-1"></div>
          </div>

          <!-- Step 2 Indicator -->
          <div class="flex items-center gap-2 flex-1 justify-center" id="step-indicator-2">
            <span class="step-badge grid h-7 w-7 shrink-0 place-items-center rounded-full text-xs font-bold transition-all duration-300 bg-lila-pastel text-texto-secundario">
              2
            </span>
            <span class="step-label text-xs font-semibold tracking-wider text-texto-secundario hidden sm:inline">
              Contacto
            </span>
          </div>
          <div class="h-0.5 flex-1 bg-lila-suave/40 rounded-full overflow-hidden">
            <div class="step-line-fill h-full w-0 bg-violeta-osc transition-all duration-300" id="step-line-2"></div>
          </div>

          <!-- Step 3 Indicator -->
          <div class="flex items-center gap-2 flex-1 justify-end" id="step-indicator-3">
            <span class="step-badge grid h-7 w-7 shrink-0 place-items-center rounded-full text-xs font-bold transition-all duration-300 bg-lila-pastel text-texto-secundario">
              3
            </span>
            <span class="step-label text-xs font-semibold tracking-wider text-texto-secundario hidden sm:inline">
              Resumen
            </span>
          </div>
        </div>
      </div>

      <!-- Card Title & Subtitle (dynamically updated per step) -->
      <div class="mb-6 text-center sm:mb-8" id="step-header">
        <p class="font-display text-xs sm:text-sm font-semibold uppercase tracking-[0.14em] text-violeta-osc" id="step-eyebrow">
          {eyebrow}
        </p>
        <h2 class="font-display mx-auto mt-2 max-w-xl text-2xl font-semibold leading-[1.15] tracking-[-0.01em] text-indigo-texto sm:text-3xl lg:text-4xl min-h-[3.25rem] sm:min-h-[4.25rem] lg:min-h-[5.25rem] content-center" id="step-title">
          ¿Qué tipo de espacio necesitás gestionar?
        </h2>
        <p class="mx-auto mt-2 max-w-lg text-sm leading-relaxed text-texto-secundario sm:text-base min-h-[2.75rem] sm:min-h-[3.25rem] content-center" id="step-subtitle">
          Elegí tu rubro para armar una propuesta a medida.
        </p>
      </div>

      <!-- Main Multi-step Form -->
      <form id="contact-form" novalidate class="relative">
        <!-- Hidden input for standard form serialization -->
        <input type="hidden" id="tipo-espacio-input" name="tipo-espacio" value="" />

        <!-- Live region for accessibility & test assertions -->
        <div id="form-error-live" aria-live="polite" role="status" class="sr-only"></div>

        <!-- Carousel Step Wrapper -->
        <div class="relative overflow-clip min-h-[320px] transition-[height] duration-300 ease-out" id="steps-container">

          <!-- ========================================================= -->
          <!-- PASO 1: Selección de tipo de espacio                      -->
          <!-- ========================================================= -->
          <div
            id="step-panel-1"
            data-step-panel="1"
            class="step-panel w-full h-full transition-all duration-300 ease-out"
          >
            <div class="space-y-3.5 sm:space-y-4" role="radiogroup" aria-labelledby="step-title" id="space-options-group">
              <!-- Opción 1: Consorcio -->
              <button
                type="button"
                data-space-option="consorcio"
                role="radio"
                aria-checked="false"
                class="space-option-card group w-full flex items-center justify-between p-4 sm:p-5 rounded-2xl border border-lila-suave/60 bg-white/80 backdrop-blur-xs text-left transition-all duration-200 hover:border-violeta-osc hover:bg-white hover:shadow-md cursor-pointer focus:outline-none focus:ring-2 focus:ring-violeta-osc"
              >
                <div class="flex items-center gap-4">
                  <div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-lila-pastel text-violeta-osc transition-colors group-hover:bg-violeta-osc group-hover:text-white">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
                      <rect width="16" height="20" x="4" y="2" rx="2" />
                      <path d="M9 22v-4h6v4" />
                      <path d="M8 6h.01" />
                      <path d="M16 6h.01" />
                      <path d="M8 10h.01" />
                      <path d="M16 10h.01" />
                      <path d="M8 14h.01" />
                      <path d="M16 14h.01" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-display text-base sm:text-lg font-semibold text-indigo-texto">
                      Consorcio / Edificio residencial
                    </h3>
                    <p class="text-xs sm:text-sm text-texto-secundario mt-0.5">
                      Hall, palieres, cocheras, vidrios y áreas comunes.
                    </p>
                  </div>
                </div>
                <div class="shrink-0 pl-3">
                  <span class="arrow-indicator grid h-8 w-8 place-items-center rounded-full bg-lila-pastel/60 text-violeta-osc transition-all group-hover:translate-x-1 group-hover:bg-violeta-osc group-hover:text-white">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                      <path d="m9 18 6-6-6-6" />
                    </svg>
                  </span>
                </div>
              </button>

              <!-- Opción 2: Oficinas -->
              <button
                type="button"
                data-space-option="oficina"
                role="radio"
                aria-checked="false"
                class="space-option-card group w-full flex items-center justify-between p-4 sm:p-5 rounded-2xl border border-lila-suave/60 bg-white/80 backdrop-blur-xs text-left transition-all duration-200 hover:border-violeta-osc hover:bg-white hover:shadow-md cursor-pointer focus:outline-none focus:ring-2 focus:ring-violeta-osc"
              >
                <div class="flex items-center gap-4">
                  <div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-lila-pastel text-violeta-osc transition-colors group-hover:bg-violeta-osc group-hover:text-white">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
                      <rect width="20" height="14" x="2" y="7" rx="2" />
                      <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-display text-base sm:text-lg font-semibold text-indigo-texto">
                      Oficinas / Sede corporativa
                    </h3>
                    <p class="text-xs sm:text-sm text-texto-secundario mt-0.5">
                      Puestos de trabajo, salas de reunión, sanitarios y cocina.
                    </p>
                  </div>
                </div>
                <div class="shrink-0 pl-3">
                  <span class="arrow-indicator grid h-8 w-8 place-items-center rounded-full bg-lila-pastel/60 text-violeta-osc transition-all group-hover:translate-x-1 group-hover:bg-violeta-osc group-hover:text-white">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                      <path d="m9 18 6-6-6-6" />
                    </svg>
                  </span>
                </div>
              </button>

              <!-- Opción 3: Clínicas -->
              <button
                type="button"
                data-space-option="clinica"
                role="radio"
                aria-checked="false"
                class="space-option-card group w-full flex items-center justify-between p-4 sm:p-5 rounded-2xl border border-lila-suave/60 bg-white/80 backdrop-blur-xs text-left transition-all duration-200 hover:border-violeta-osc hover:bg-white hover:shadow-md cursor-pointer focus:outline-none focus:ring-2 focus:ring-violeta-osc"
              >
                <div class="flex items-center gap-4">
                  <div class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-lila-pastel text-violeta-osc transition-colors group-hover:bg-violeta-osc group-hover:text-white">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6" aria-hidden="true">
                      <path d="M11 2a2 2 0 0 0-2 2v5H4a2 2 0 0 0-2 2v2c0 1.1.9 2 2 2h5v5c0 1.1.9 2 2 2h2a2 2 0 0 0 2-2v-5h5a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2h-5V4a2 2 0 0 0-2-2h-2z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-display text-base sm:text-lg font-semibold text-indigo-texto">
                      Clínica / Centro médico
                    </h3>
                    <p class="text-xs sm:text-sm text-texto-secundario mt-0.5">
                      Consultorios, salas de espera y normas de bioseguridad.
                    </p>
                  </div>
                </div>
                <div class="shrink-0 pl-3">
                  <span class="arrow-indicator grid h-8 w-8 place-items-center rounded-full bg-lila-pastel/60 text-violeta-osc transition-all group-hover:translate-x-1 group-hover:bg-violeta-osc group-hover:text-white">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                      <path d="m9 18 6-6-6-6" />
                    </svg>
                  </span>
                </div>
              </button>
            </div>

            <!-- Error de paso 1 si no se selecciona nada -->
            <div id="step1-error" class="mt-3 hidden text-xs font-medium text-violeta-osc text-center"></div>
          </div>

          <!-- ========================================================= -->
          <!-- PASO 2: Opciones de contacto + Teléfono                   -->
          <!-- ========================================================= -->
          <div
            id="step-panel-2"
            data-step-panel="2"
            class="step-panel absolute inset-0 w-full h-full opacity-0 pointer-events-none translate-x-8 transition-all duration-300 ease-out"
          >
            <div class="flex flex-col justify-between h-full">
              <div class="space-y-7 sm:space-y-8 lg:space-y-9">
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6">
                  <!-- Nombre -->
                  <div class="space-y-2" data-field-wrapper>
                    <label for="nombre" class="block text-xs font-semibold uppercase tracking-wider text-indigo-texto">
                      Nombre y apellido *
                    </label>
                    <input
                      type="text"
                      id="nombre"
                      name="nombre"
                      required
                      placeholder="Tu nombre completo"
                      class="w-full rounded-2xl border border-lila-suave/50 bg-white/80 px-4 py-3.5 sm:py-4 text-sm text-indigo-texto placeholder:text-texto-secundario/50 backdrop-blur-xs transition-all duration-200 hover:border-lila-medio/60 focus:border-violeta-osc focus:bg-white focus:outline-none focus:ring-3 focus:ring-violeta-osc/15"
                    />
                  </div>

                  <!-- Institución / Edificio -->
                  <div class="space-y-2" data-field-wrapper>
                    <label for="institucion" class="block text-xs font-semibold uppercase tracking-wider text-indigo-texto">
                      Institución o edificio *
                    </label>
                    <input
                      type="text"
                      id="institucion"
                      name="institucion"
                      required
                      placeholder="Ej: Consorcio Av. Libertador 1400"
                      class="w-full rounded-2xl border border-lila-suave/50 bg-white/80 px-4 py-3.5 sm:py-4 text-sm text-indigo-texto placeholder:text-texto-secundario/50 backdrop-blur-xs transition-all duration-200 hover:border-lila-medio/60 focus:border-violeta-osc focus:bg-white focus:outline-none focus:ring-3 focus:ring-violeta-osc/15"
                    />
                  </div>
                </div>

                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6">
                  <!-- Email -->
                  <div class="space-y-2" data-field-wrapper>
                    <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-indigo-texto">
                      Email de contacto *
                    </label>
                    <input
                      type="email"
                      id="email"
                      name="email"
                      required
                      placeholder="tu@edificio-empresa.com"
                      class="w-full rounded-2xl border border-lila-suave/50 bg-white/80 px-4 py-3.5 sm:py-4 text-sm text-indigo-texto placeholder:text-texto-secundario/50 backdrop-blur-xs transition-all duration-200 hover:border-lila-medio/60 focus:border-violeta-osc focus:bg-white focus:outline-none focus:ring-3 focus:ring-violeta-osc/15"
                    />
                  </div>

                  <!-- Teléfono / WhatsApp -->
                  <div class="space-y-2" data-field-wrapper>
                    <label for="telefono" class="block text-xs font-semibold uppercase tracking-wider text-indigo-texto">
                      Número de teléfono / WhatsApp *
                    </label>
                    <input
                      type="tel"
                      id="telefono"
                      name="telefono"
                      required
                      placeholder="Ej: 11 2345-6789"
                      class="w-full rounded-2xl border border-lila-suave/50 bg-white/80 px-4 py-3.5 sm:py-4 text-sm text-indigo-texto placeholder:text-texto-secundario/50 backdrop-blur-xs transition-all duration-200 hover:border-lila-medio/60 focus:border-violeta-osc focus:bg-white focus:outline-none focus:ring-3 focus:ring-violeta-osc/15"
                    />
                  </div>
                </div>
              </div>

              <!-- Barra inferior de navegación: Volver (abajo izq) y Siguiente (der) -->
              <div class="flex items-center justify-between pt-4 sm:pt-6 border-t border-lila-suave/30 mt-auto">
                <button
                  type="button"
                  id="btn-step2-back"
                  class="inline-flex items-center gap-2 rounded-full border border-lila-suave/60 px-5 py-2.5 sm:py-3 text-xs sm:text-sm font-semibold text-indigo-texto hover:bg-lila-pastel/50 transition-all duration-200 cursor-pointer active:scale-95"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                    <path d="m15 18-6-6 6-6" />
                  </svg>
                  <span>Volver</span>
                </button>

                <button
                  type="button"
                  id="btn-step2-next"
                  class="btn-primary inline-flex items-center gap-2 rounded-full px-6 sm:px-7 py-2.5 sm:py-3 text-xs sm:text-sm font-semibold transition-all duration-200 cursor-pointer shadow-md hover:shadow-lg active:scale-95"
                >
                  <span>Siguiente</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                    <path d="m9 18 6-6-6-6" />
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- ========================================================= -->
          <!-- PASO 3: Resumen y botón de enviar                         -->
          <!-- ========================================================= -->
          <div
            id="step-panel-3"
            data-step-panel="3"
            class="step-panel absolute inset-0 w-full h-full opacity-0 pointer-events-none translate-x-8 transition-all duration-300 ease-out"
          >
            <div class="flex flex-col justify-between h-full">
              <!-- Resumen de datos -->
              <div class="rounded-2xl border border-lila-suave/60 bg-white/90 p-3.5 sm:p-4 shadow-xs space-y-2">
                <div class="flex items-center justify-between pb-1.5 border-b border-lila-suave/30">
                  <span class="text-xs font-bold uppercase tracking-wider text-violeta-osc">Resumen del diagnóstico</span>
                  <button
                    type="button"
                    id="step3-edit-btn"
                    class="text-xs font-semibold text-violeta-osc underline hover:text-indigo-texto cursor-pointer"
                  >
                    Modificar datos
                  </button>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1.5 sm:gap-y-2 text-xs sm:text-sm py-0.5">
                  <div class="space-y-0.5">
                    <span class="block text-[11px] font-medium text-texto-secundario">Tipo de espacio</span>
                    <span id="summary-tipo-espacio" class="font-semibold text-indigo-texto">Consorcio / Edificio</span>
                  </div>
                  <div class="space-y-0.5">
                    <span class="block text-[11px] font-medium text-texto-secundario">Institución o edificio</span>
                    <span id="summary-institucion" class="font-semibold text-indigo-texto">-</span>
                  </div>
                  <div class="space-y-0.5">
                    <span class="block text-[11px] font-medium text-texto-secundario">Nombre del contacto</span>
                    <span id="summary-nombre" class="font-semibold text-indigo-texto">-</span>
                  </div>
                  <div class="space-y-0.5">
                    <span class="block text-[11px] font-medium text-texto-secundario">Email de contacto</span>
                    <span id="summary-email" class="font-semibold text-indigo-texto break-all">-</span>
                  </div>
                  <div class="sm:col-span-2 space-y-0.5">
                    <span class="block text-[11px] font-medium text-texto-secundario">Teléfono / WhatsApp</span>
                    <span id="summary-telefono" class="font-semibold text-indigo-texto">-</span>
                  </div>
                </div>
              </div>

              <!-- Barra inferior: Volver (abajo izq) + CTA Submit (der) -->
              <div class="mt-auto pt-3 sm:pt-3.5 border-t border-lila-suave/50 pb-1">
                <div class="flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between">
                  <button
                    type="button"
                    id="btn-step3-back"
                    class="inline-flex items-center justify-center gap-2 rounded-full border border-lila-suave/60 px-5 py-2.5 sm:py-3 text-xs sm:text-sm font-semibold text-indigo-texto hover:bg-lila-pastel/50 transition-all duration-200 cursor-pointer active:scale-95 w-full sm:w-auto"
                  >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                      <path d="m15 18-6-6 6-6" />
                    </svg>
                    <span>Volver</span>
                  </button>

                  <div class="flex flex-col sm:flex-row sm:items-center gap-3">
                    <CtaRampButton
                      type="submit"
                      text="Pedí tu presupuesto por mail"
                      variant="primary"
                      rampDirection="left"
                      class="w-full sm:w-auto"
                    />
                  </div>
                </div>

                <p class="mt-2 text-[11px] font-medium uppercase tracking-wider text-texto-secundario text-center leading-relaxed">
                  Evaluamos tu caso de forma confidencial y sin costo inicial.
                </p>
              </div>
            </div>
          </div>

          <!-- ========================================================= -->
          <!-- PANTALLA DE ÉXITO                                        -->
          <!-- ========================================================= -->
          <div
            id="step-panel-success"
            class="step-panel absolute inset-0 opacity-0 pointer-events-none translate-x-8 transition-all duration-300 ease-out text-center py-6 sm:py-10"
          >
            <div class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-[#3FA88F]/15 text-[#3FA88F] mb-4">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-8 w-8">
                <path d="M20 6 9 17l-5-5" />
              </svg>
            </div>
            <h3 class="font-display text-2xl sm:text-3xl font-semibold text-indigo-texto">
              ¡Diagnóstico solicitado!
            </h3>
            <p class="mt-2 text-sm text-texto-secundario max-w-md mx-auto leading-relaxed">
              Recibimos los datos de tu espacio. Te vamos a responder por mail dentro de las próximas 24 horas.
            </p>
            <div class="mt-6">
              <button
                type="button"
                id="btn-reset-form"
                class="btn-secondary rounded-full px-6 py-2.5 text-xs sm:text-sm font-semibold transition-all duration-200 cursor-pointer active:scale-95"
              >
                Enviar otra consulta
              </button>
            </div>
          </div>

        </div>
      </form>
    </div>
  </div>
  </div>
</section>

<script>
  import { validateStep2, validateContactForm } from '../lib/contact';

  // State
  let currentStep = 1;
  const totalSteps = 3;

  const spaceLabels: Record<string, string> = {
    consorcio: 'Consorcio / Edificio residencial',
    oficina: 'Oficinas / Sede corporativa',
    clinica: 'Clínica / Centro médico',
  };

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const stepsContainer = document.getElementById('steps-container');
  const panels = [
    document.getElementById('step-panel-1'),
    document.getElementById('step-panel-2'),
    document.getElementById('step-panel-3'),
  ];
  const successPanel = document.getElementById('step-panel-success');

  const stepEyebrow = document.getElementById('step-eyebrow');
  const stepTitle = document.getElementById('step-title');
  const stepSubtitle = document.getElementById('step-subtitle');

  const tipoEspacioInput = document.getElementById('tipo-espacio-input') as HTMLInputElement | null;
  const spaceOptions = document.querySelectorAll<HTMLButtonElement>('[data-space-option]');
  const errorLive = document.getElementById('form-error-live');
  const step1Error = document.getElementById('step1-error');

  const inputNombre = document.getElementById('nombre') as HTMLInputElement | null;
  const inputEmail = document.getElementById('email') as HTMLInputElement | null;
  const inputTelefono = document.getElementById('telefono') as HTMLInputElement | null;
  const inputInstitucion = document.getElementById('institucion') as HTMLInputElement | null;

  // Summary elements
  const summaryTipoEspacio = document.getElementById('summary-tipo-espacio');
  const summaryInstitucion = document.getElementById('summary-institucion');
  const summaryNombre = document.getElementById('summary-nombre');
  const summaryEmail = document.getElementById('summary-email');
  const summaryTelefono = document.getElementById('summary-telefono');

  // Navigation buttons
  const btnStep2Back = document.getElementById('btn-step2-back');
  const btnStep2Next = document.getElementById('btn-step2-next');
  const btnStep3Back = document.getElementById('btn-step3-back');
  const step3EditBtn = document.getElementById('step3-edit-btn');
  const btnResetForm = document.getElementById('btn-reset-form');

  // Step headers data
  const stepHeaders = {
    1: {
      eyebrow: '07 // Contacto',
      title: '¿Qué tipo de espacio necesitás gestionar?',
      subtitle: 'Elegí tu rubro para armar una propuesta a medida.',
    },
    2: {
      eyebrow: 'Paso 2 de 3 — Datos de contacto',
      title: 'Contanos sobre tu espacio',
      subtitle: 'Dejanos tus datos para coordinar el diagnóstico, sin costo.',
    },
    3: {
      eyebrow: 'Paso 3 de 3 — Confirmación',
      title: 'Revisá tu solicitud',
      subtitle: 'Confirmá que esté todo bien antes de enviar el pedido de diagnóstico.',
    },
  };

  const spaceOptionsGroup = document.getElementById('space-options-group');
  let lockedStep1Height = 0;

  function getStep1BaselineHeight(): number {
    if (spaceOptionsGroup && spaceOptionsGroup.offsetHeight > 0) {
      lockedStep1Height = spaceOptionsGroup.offsetHeight;
      return lockedStep1Height;
    }
    return lockedStep1Height;
  }

  // Adjust container height to maintain step 1 baseline across all steps
  function updateContainerHeight(panel: HTMLElement | null) {
    if (!stepsContainer) return;
    const baselineH = getStep1BaselineHeight();
    const innerContent = panel?.firstElementChild as HTMLElement | null;
    const contentH = innerContent ? innerContent.scrollHeight : (panel ? panel.offsetHeight : 0);
    const targetHeight = Math.max(baselineH, contentH);
    if (targetHeight > 0) {
      stepsContainer.style.height = `${targetHeight}px`;
    }
  }

  // Update Stepper Progress UI
  function updateStepperUI(targetStep: number) {
    for (let i = 1; i <= totalSteps; i++) {
      const indicator = document.getElementById(`step-indicator-${i}`);
      const badge = indicator?.querySelector('.step-badge');
      const label = indicator?.querySelector('.step-label');
      const lineFill = document.getElementById(`step-line-${i}`);

      if (i < targetStep) {
        // Completed step
        badge?.classList.remove('bg-violeta-osc', 'text-white', 'bg-lila-pastel', 'text-texto-secundario');
        badge?.classList.add('bg-violeta-osc', 'text-white');
        label?.classList.remove('text-texto-secundario');
        label?.classList.add('text-indigo-texto', 'font-semibold');
        if (lineFill) (lineFill as HTMLElement).style.width = '100%';
      } else if (i === targetStep) {
        // Active step
        badge?.classList.remove('bg-lila-pastel', 'text-texto-secundario');
        badge?.classList.add('bg-violeta-osc', 'text-white');
        label?.classList.remove('text-texto-secundario');
        label?.classList.add('text-indigo-texto', 'font-semibold');
        if (lineFill) (lineFill as HTMLElement).style.width = '0%';
      } else {
        // Upcoming step
        badge?.classList.remove('bg-violeta-osc', 'text-white');
        badge?.classList.add('bg-lila-pastel', 'text-texto-secundario');
        label?.classList.remove('text-indigo-texto');
        label?.classList.add('text-texto-secundario');
        if (lineFill) (lineFill as HTMLElement).style.width = '0%';
      }
    }

    const header = stepHeaders[targetStep as 1 | 2 | 3];
    if (header) {
      if (stepEyebrow) stepEyebrow.textContent = header.eyebrow;
      if (stepTitle) stepTitle.textContent = header.title;
      if (stepSubtitle) stepSubtitle.textContent = header.subtitle;
    }
  }

  // Clear all validation field errors
  const clearFieldErrors = () => {
    document.querySelectorAll<HTMLElement>('[data-field-error]').forEach((el) => el.remove());
    form?.querySelectorAll('[aria-invalid="true"]').forEach((el) => el.removeAttribute('aria-invalid'));
    if (step1Error) {
      step1Error.textContent = '';
      step1Error.classList.add('hidden');
    }
  };

  // Attach error message to a form field wrapper
  const showFieldError = (input: HTMLElement, message: string) => {
    const wrapper = input.closest<HTMLElement>('[data-field-wrapper]');
    let err = wrapper?.querySelector<HTMLElement>('[data-field-error]');
    if (!err && wrapper) {
      err = document.createElement('p');
      err.setAttribute('data-field-error', '');
      err.id = `${input.id}-error`;
      err.className = 'text-xs font-medium text-violeta-osc mt-1';
      wrapper.appendChild(err);
    }
    if (err) {
      err.textContent = message;
      input.setAttribute('aria-invalid', 'true');
      input.setAttribute('aria-describedby', err.id);
    }
  };

  // Transition between steps with spatial awareness
  function goToStep(targetStep: number) {
    if (targetStep < 1 || targetStep > totalSteps || targetStep === currentStep) return;

    clearFieldErrors();
    if (stepsContainer) stepsContainer.scrollLeft = 0;
    const goingForward = targetStep > currentStep;
    const currentPanel = panels[currentStep - 1];
    const nextPanel = panels[targetStep - 1];

    if (!currentPanel || !nextPanel) return;

    // Animate current panel out
    currentPanel.classList.add('pointer-events-none', 'opacity-0');
    currentPanel.classList.remove('opacity-100');
    if (goingForward) {
      currentPanel.classList.add('-translate-x-8');
      currentPanel.classList.remove('translate-x-0', 'translate-x-8');
    } else {
      currentPanel.classList.add('translate-x-8');
      currentPanel.classList.remove('translate-x-0', '-translate-x-8');
    }

    // Set initial offset for next panel
    nextPanel.classList.add('pointer-events-none', 'opacity-0');
    if (goingForward) {
      nextPanel.classList.add('translate-x-8');
      nextPanel.classList.remove('-translate-x-8', 'translate-x-0');
    } else {
      nextPanel.classList.add('-translate-x-8');
      nextPanel.classList.remove('translate-x-8', 'translate-x-0');
    }

    // Animate next panel in after tiny frame
    requestAnimationFrame(() => {
      // Switch active panels
      currentPanel.classList.add('absolute', 'inset-0');
      nextPanel.classList.remove('absolute', 'inset-0', 'pointer-events-none');
      nextPanel.classList.remove('-translate-x-8', 'translate-x-8');
      nextPanel.classList.add('translate-x-0', 'opacity-100');

      if (stepsContainer) stepsContainer.scrollLeft = 0;
      currentStep = targetStep;
      updateStepperUI(currentStep);
      updateContainerHeight(nextPanel);

      // Populate summary when arriving at Step 3
      if (currentStep === 3) {
        populateSummary();
      }

      // Focus first input of the new step for accessibility without scrolling parent container
      if (currentStep === 2) {
        inputNombre?.focus({ preventScroll: true });
      } else if (currentStep === 3) {
        const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
        submitBtn?.focus({ preventScroll: true });
      }
    });
  }

  // Populate Step 3 summary card
  function populateSummary() {
    const spaceKey = tipoEspacioInput?.value || '';
    if (summaryTipoEspacio) summaryTipoEspacio.textContent = spaceLabels[spaceKey] || 'No seleccionado';
    if (summaryInstitucion) summaryInstitucion.textContent = inputInstitucion?.value.trim() || '-';
    if (summaryNombre) summaryNombre.textContent = inputNombre?.value.trim() || '-';
    if (summaryEmail) summaryEmail.textContent = inputEmail?.value.trim() || '-';
    if (summaryTelefono) summaryTelefono.textContent = inputTelefono?.value.trim() || '-';
  }

  // Handle Step 1 space option clicks
  spaceOptions.forEach((btn) => {
    btn.addEventListener('click', () => {
      const value = btn.getAttribute('data-space-option') || '';
      if (!value) return;

      // Update hidden input
      if (tipoEspacioInput) tipoEspacioInput.value = value;

      // Highlight selected button
      spaceOptions.forEach((b) => {
        b.setAttribute('aria-checked', 'false');
        b.classList.remove('border-violeta-osc', 'bg-lila-pastel/40', 'ring-2', 'ring-violeta-osc/30');
      });
      btn.setAttribute('aria-checked', 'true');
      btn.classList.add('border-violeta-osc', 'bg-lila-pastel/40', 'ring-2', 'ring-violeta-osc/30');

      // Brief tactile delay for delightful feedback, then auto advance to step 2
      setTimeout(() => {
        goToStep(2);
      }, 160);
    });
  });

  // Step 2 "Volver"
  btnStep2Back?.addEventListener('click', () => {
    goToStep(1);
  });

  // Step 2 "Siguiente"
  function validateAndAdvanceStep2(): boolean {
    clearFieldErrors();
    const values = {
      nombre: inputNombre?.value ?? '',
      email: inputEmail?.value ?? '',
      telefono: inputTelefono?.value ?? '',
      institucion: inputInstitucion?.value ?? '',
    };

    const errors = validateStep2(values);

    for (const err of errors) {
      const fieldEl = form?.querySelector<HTMLInputElement>(`input[name="${err.field}"]`);
      if (fieldEl) showFieldError(fieldEl, err.message);
    }

    if (errors.length > 0) {
      const firstError = form?.querySelector('[aria-invalid="true"]') as HTMLElement | null;
      firstError?.focus({ preventScroll: true });
      if (errorLive) errorLive.textContent = 'Revisá los campos marcados en el formulario.';
      return false;
    }

    goToStep(3);
    return true;
  }

  btnStep2Next?.addEventListener('click', () => {
    validateAndAdvanceStep2();
  });

  // Pressing Enter in any text input inside Step 2 triggers "Siguiente"
  const step2Inputs = [inputNombre, inputEmail, inputTelefono, inputInstitucion];
  step2Inputs.forEach((input) => {
    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        validateAndAdvanceStep2();
      }
    });
  });

  // Step 3 "Volver" and "Modificar"
  btnStep3Back?.addEventListener('click', () => {
    goToStep(2);
  });

  step3EditBtn?.addEventListener('click', () => {
    goToStep(2);
  });

  // Form Submit Handler
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    clearFieldErrors();
    if (errorLive) errorLive.textContent = '';

    const values = {
      nombre: inputNombre?.value ?? '',
      email: inputEmail?.value ?? '',
      telefono: inputTelefono?.value ?? '',
      institucion: inputInstitucion?.value ?? '',
      tipoEspacio: tipoEspacioInput?.value ?? '',
    };

    const errors = validateContactForm(values);

    if (errors.length > 0) {
      // Find what step the first error belongs to
      const hasStep1Error = errors.some((err) => err.field === 'tipoEspacio');
      if (hasStep1Error) {
        goToStep(1);
        if (step1Error) {
          step1Error.textContent = 'Seleccioná el tipo de espacio.';
          step1Error.classList.remove('hidden');
        }
        return;
      }

      goToStep(2);
      for (const err of errors) {
        const fieldEl = form?.querySelector<HTMLInputElement>(`input[name="${err.field}"]`);
        if (fieldEl) showFieldError(fieldEl, err.message);
      }
      const firstError = form?.querySelector('[aria-invalid="true"]') as HTMLElement | null;
      firstError?.focus({ preventScroll: true });
      if (errorLive) errorLive.textContent = 'Revisá los campos marcados en el formulario.';
      return;
    }

    // Success State
    if (errorLive) errorLive.textContent = 'Formulario enviado. Nos vamos a contactar por mail.';

    // Hide stepper and transition to success screen
    const stepper = document.getElementById('form-stepper');
    if (stepper) stepper.classList.add('opacity-0', 'pointer-events-none');
    if (stepEyebrow) stepEyebrow.textContent = 'SOLICITUD CONFIRMADA';
    if (stepTitle) stepTitle.textContent = '¡Muchas gracias por contactarnos!';
    if (stepSubtitle) stepSubtitle.textContent = 'Evaluamos tu solicitud de diagnóstico.';

    panels.forEach((p) => {
      p?.classList.add('absolute', 'pointer-events-none', 'opacity-0');
      p?.classList.remove('opacity-100');
    });

    if (successPanel) {
      successPanel.classList.remove('absolute', 'pointer-events-none', 'translate-x-8');
      successPanel.classList.add('opacity-100', 'translate-x-0');
      if (stepsContainer) stepsContainer.scrollLeft = 0;
      updateContainerHeight(successPanel);
      btnResetForm?.focus({ preventScroll: true });
    }
  });

  // Reset Form
  btnResetForm?.addEventListener('click', () => {
    form?.reset();
    if (tipoEspacioInput) tipoEspacioInput.value = '';
    spaceOptions.forEach((b) => {
      b.setAttribute('aria-checked', 'false');
      b.classList.remove('border-violeta-osc', 'bg-lila-pastel/40', 'ring-2', 'ring-violeta-osc/30');
    });

    const stepper = document.getElementById('form-stepper');
    if (stepper) stepper.classList.remove('opacity-0', 'pointer-events-none');

    if (successPanel) {
      successPanel.classList.add('absolute', 'pointer-events-none', 'translate-x-8', 'opacity-0');
      successPanel.classList.remove('opacity-100', 'translate-x-0');
    }

    currentStep = 1;
    if (stepsContainer) stepsContainer.scrollLeft = 0;
    panels.forEach((p, idx) => {
      if (idx === 0) {
        p?.classList.remove('absolute', 'inset-0', 'pointer-events-none', '-translate-x-8', 'translate-x-8');
        p?.classList.add('opacity-100', 'translate-x-0');
      } else {
        p?.classList.add('absolute', 'inset-0', 'pointer-events-none', 'opacity-0', 'translate-x-8');
        p?.classList.remove('opacity-100', 'translate-x-0', '-translate-x-8');
      }
    });
    updateStepperUI(1);
    updateContainerHeight(panels[0]);
  });

  // Ensure the carousel container never maintains horizontal scroll offset
  stepsContainer?.addEventListener('scroll', () => {
    if (stepsContainer.scrollLeft !== 0) {
      stepsContainer.scrollLeft = 0;
    }
  });

  // Window resize handler to maintain responsiveness
  window.addEventListener('resize', () => {
    const activePanel = panels[currentStep - 1];
    if (stepsContainer) stepsContainer.scrollLeft = 0;
    updateContainerHeight(activePanel);
  });

  // Initialize initial container height once rendered
  window.addEventListener('load', () => {
    updateContainerHeight(panels[0]);
  });
  updateContainerHeight(panels[0]);

  // Reveal IntersectionObserver
  const revealTargets = document.querySelectorAll<HTMLElement>('#contacto [data-reveal]');
  if (revealTargets.length) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      revealTargets.forEach((el) => el.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.1 },
      );
      revealTargets.forEach((el) => observer.observe(el));
    }
  }
</script>
