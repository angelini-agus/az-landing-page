---
// Footer.astro — Global footer for AZ Limpieza.
// Includes navigation links, contact email, coverage area, and institutional client portal login.
const currentYear = new Date().getFullYear();
const clientLoginUrl = '/login';
---

<footer class="relative border-t border-lila-suave/40 bg-bg-claro pt-16 pb-12">
  <div class="container-page">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-5 lg:gap-8 pb-12 border-b border-lila-suave/30">
      <!-- Col 1: Brand & Bio -->
      <div class="space-y-4 lg:col-span-2">
        <a
          href="/"
          aria-label="AZ Limpieza — Inicio"
          class="inline-flex items-center gap-2.5 rounded-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-lila-medio"
        >
          <img
            src="/logo.png"
            alt="Isologo AZ Limpieza"
            width={36}
            height={36}
            class="h-9 w-9"
          />
          <span class="text-xl font-bold text-indigo-texto font-display">
            AZ Limpieza
          </span>
        </a>
        <p class="max-w-sm text-sm leading-relaxed text-texto-secundario">
          Servicio de limpieza profesional con equipo propio y asistencia controlada por QR y GPS.
        </p>
        <div class="pt-2">
          <span class="inline-flex items-center gap-2 rounded-full border border-lila-suave/45 bg-lila-pastel/40 px-3.5 py-1 text-xs font-medium text-texto-secundario">
            <span class="h-2 w-2 rounded-full bg-turq-cta"></span>
            Rosario, Santa Fe
          </span>
        </div>
      </div>

      <!-- Col 2: Servicios -->
      <div class="space-y-3">
        <p class="font-display text-xs font-bold uppercase tracking-wider text-indigo-texto">
          Servicios
        </p>
        <ul class="space-y-2 text-sm text-texto-secundario">
          <li>
            <a href="#servicios" class="transition-colors hover:text-violeta-osc">
              Consorcios y Edificios
            </a>
          </li>
          <li>
            <a href="#servicios" class="transition-colors hover:text-violeta-osc">
              Oficinas y Empresas
            </a>
          </li>
          <li>
            <a href="#servicios" class="transition-colors hover:text-violeta-osc">
              Clínicas y Centros de Salud
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Empresa / Proceso -->
      <div class="space-y-3">
        <p class="font-display text-xs font-bold uppercase tracking-wider text-indigo-texto">
          Navegación
        </p>
        <ul class="space-y-2 text-sm text-texto-secundario">
          <li>
            <a href="#como-trabajamos" class="transition-colors hover:text-violeta-osc">
              Quiénes somos
            </a>
          </li>
          <li>
            <a href="#valor" class="transition-colors hover:text-violeta-osc">
              Por qué elegirnos
            </a>
          </li>
          <li>
            <a href="#como-funciona" class="transition-colors hover:text-violeta-osc">
              Cómo trabajamos
            </a>
          </li>
          <li>
            <a href="#faq" class="transition-colors hover:text-violeta-osc">
              Preguntas frecuentes
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Portal Institucional -->
      <div class="space-y-3">
        <p class="font-display text-xs font-bold uppercase tracking-wider text-indigo-texto">
          Portal Institucional
        </p>
        <div class="space-y-2.5 text-sm text-texto-secundario">
          <p class="text-xs text-texto-secundario">
            Ingreso para el equipo de AZ.
          </p>

          <!-- Institutional ERP Login Button (separated from commercial CTA) -->
          <div class="pt-2">
            <a
              href={clientLoginUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl border border-lila-suave/60 bg-white px-4 py-2 text-xs font-semibold text-violeta-osc shadow-2xs transition-all duration-200 hover:border-violeta-osc hover:bg-violeta-osc hover:text-white"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5" aria-hidden="true">
                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                <polyline points="10 17 15 12 10 7" />
                <line x1="15" y1="12" x2="3" y2="12" />
              </svg>
              Acceso empleados
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom copyright bar -->
    <div class="flex flex-col gap-4 pt-8 text-xs text-texto-secundario sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {currentYear} AZ Servicios de Limpieza. Todos los derechos reservados.
      </p>
      <p class="text-[11px] text-texto-secundario">
        Gestión operativa y asistencia con trazabilidad digital ServiceTrack.
      </p>
    </div>
  </div>
</footer>
