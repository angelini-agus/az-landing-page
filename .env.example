# ==============================================================================
# AZ Servicios de Limpieza — Variables de Entorno de Ejemplo
# ==============================================================================
# NOTA DE SEGURIDAD:
# Nunca agregues valores reales en este archivo ni comitees archivos .env al repositorio.
# Las credenciales y claves de producción deben configurarse directamente en:
# Vercel Dashboard -> Proyecto -> Settings -> Environment Variables.
# ==============================================================================

# URL pública del sitio (para metadatos OpenGraph, canonicals y sitemap)
PUBLIC_SITE_URL=https://www.azserviciosdelimpieza.com

# Endpoint / Clave de servicio para el envío de formularios de contacto (opcional según integración)
# CONTACT_API_KEY=
# CONTACT_NOTIFICATION_EMAIL=
